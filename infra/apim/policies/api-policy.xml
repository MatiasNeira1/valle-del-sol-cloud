<policies>
  <inbound>
    <base />
    <cors allow-credentials="true" terminate-unmatched-request="true">
      <allowed-origins>
        <origin>http://localhost:5173</origin>
        <origin>{{frontend-origin}}</origin>
      </allowed-origins>
      <allowed-methods preflight-result-max-age="300">
        <method>GET</method><method>POST</method><method>PUT</method><method>DELETE</method><method>OPTIONS</method>
      </allowed-methods>
      <allowed-headers><header>Authorization</header><header>Content-Type</header><header>X-Correlation-ID</header></allowed-headers>
      <expose-headers><header>X-Correlation-ID</header></expose-headers>
    </cors>
    <validate-jwt header-name="Authorization" require-scheme="Bearer" failed-validation-httpcode="401"
                  failed-validation-error-message="Unauthorized: missing or invalid access token"
                  output-token-variable-name="validated-jwt">
      <openid-config url="{{entra-openid-config-url}}" />
      <audiences><audience>{{api-audience}}</audience></audiences>
      <required-claims><claim name="scp" match="any"><value>api.access</value></claim></required-claims>
    </validate-jwt>
    <set-header name="X-Correlation-ID" exists-action="skip">
      <value>@(Guid.NewGuid().ToString())</value>
    </set-header>
    <set-backend-service base-url="{{gateway-url}}" />
  </inbound>
  <backend><base /></backend>
  <outbound><base /><set-header name="X-Content-Type-Options" exists-action="override"><value>nosniff</value></set-header></outbound>
  <on-error><base /></on-error>
</policies>
